{
  "name": "@job-automator/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "DATABASE_URL=file:../../../data/app.db prisma generate",
    "postinstall": "DATABASE_URL=file:../../../data/app.db prisma generate",
    "linkedin-login": "ts-node -r tsconfig-paths/register src/cli.ts login",
    "run:pipeline": "ts-node -r tsconfig-paths/register src/cli.ts run",
    "process": "ts-node -r tsconfig-paths/register src/cli.ts process"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.14.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "commander": "^14.0.0",
    "dotenv": "^16.6.1",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.0",
    "openai": "^4.104.0",
    "playwright": "^1.55.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.17.0",
    "prisma": "^6.14.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  }
}
