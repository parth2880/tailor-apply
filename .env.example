# LLM provider: groq (free) | gemini (free) | ollama (local unlimited free) | openai (paid)
# Only ONE LLM_PROVIDER / LLM_MODEL pair should be active (last wins).
# Auto-failover is always on: when a free provider hits its limit, the app tries
# the other free ones (Groq ↔ Gemini ↔ Ollama). It never auto-switches to paid OpenAI.
# For runs that never stop: install https://ollama.com then:
#   ollama pull llama3.2
# and set LLM_PROVIDER=ollama below.

# --- Groq (free): https://console.groq.com/keys ---
# llama-3.3-70b-versatile retired Aug 2026 — use openai/gpt-oss-120b
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here
LLM_MODEL=openai/gpt-oss-120b

# --- Google Gemini (free): https://aistudio.google.com/apikey ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_key
# LLM_MODEL=gemini-2.5-flash

# --- Ollama (fully local/free unlimited): run `ollama serve` + `ollama pull llama3.2` ---
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2

# --- OpenAI (paid, optional — never used by auto-failover) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# LLM_MODEL=gpt-4o-mini

# Nest/Prisma (relative to apps/api/prisma)
DATABASE_URL="file:../../../data/app.db"
